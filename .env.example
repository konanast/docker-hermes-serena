# init.sh creates .env without overwriting an existing file.
PUID=1000
PGID=1000
# latest means latest published default-branch images, potentially unreleased.
# You may pin either variable to a registry digest for repeatability.
HERMES_IMAGE=nousresearch/hermes-agent:latest
SERENA_IMAGE=ghcr.io/oraios/serena:latest
MODEL_BASE_URL=http://192.168.1.50:8000/v1
MODEL_NAME=CHANGE_ME_MODEL
# Supply your existing LAN model server key; if it requires none, use local-no-auth.
# Single-quote values containing dollar signs or # so Compose preserves them.
MODEL_API_KEY=local-no-auth
# Generated on init, unrelated to the model server key.
HERMES_API_KEY=
# Used only by docker-compose.lan.yml. Plain HTTP; use a trusted LAN or TLS proxy.
HERMES_LAN_IP=
HERMES_LAN_PORT=8642
# To persist LAN opt-in across all scripts, uncomment after setting HERMES_LAN_IP:
# COMPOSE_FILE=docker-compose.yml:docker-compose.lan.yml
